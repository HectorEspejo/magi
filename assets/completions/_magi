#compdef magi

autoload -U is-at-least

_magi() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--servidor[Ejecuta el servidor de sesiones en primer plano]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_magi_commands" \
"*::: :->magi" \
&& ret=0
    case $state in
    (magi)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:magi-command-$line[1]:"
        case $line[1] in
            (importar)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'::ruta -- Ruta del ssh_config que se importa:_files' \
&& ret=0
;;
(exportar)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(sondear)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
'*::hosts -- Hosts a sondear; sin argumentos se sondean todos:_default' \
&& ret=0
;;
(registro)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_magi__subcmd__registro_commands" \
"*::: :->registro" \
&& ret=0

    case $state in
    (registro)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:magi-registro-command-$line[1]:"
        case $line[1] in
            (exportar)
_arguments "${_arguments_options[@]}" : \
'--desde=[Solo entradas desde esta fecha (AAAA-MM-DD)]:DESDE:_default' \
'--json[Exporta en JSON en lugar de CSV]' \
'-h[Print help]' \
'--help[Print help]' \
':ruta -- Ruta del fichero de salida:_files' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_magi__subcmd__registro__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:magi-registro-help-command-$line[1]:"
        case $line[1] in
            (exportar)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
;;
(servidor)
