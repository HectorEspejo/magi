(( $+functions[_magi_commands] )) ||
_magi_commands() {
    local commands; commands=(
'importar:Importa un ssh_config (por defecto ~/.ssh/config) sin abrir la TUI' \
'exportar:Regenera ~/.ssh/magi_config sin abrir la TUI' \
'sondear:Sondea la flota sin abrir la TUI' \
'registro:Exporta el historial de MAGI' \
'servidor:El servidor de sesiones\: estado o parada' \
'conectar:Abre la TUI con una sesión nueva al host indicado' \
'tunel:Activa o para un túnel del host indicado' \
'tuneles:Lista los túneles definidos y activos' \
'snippets:Lista los snippets con sus destinos resueltos, si son críticos y su último uso' \
'sincronizaciones:Lista las sincronizaciones guardadas con su host, dirección, rutas, borrado y último resultado' \
'diagnostico:Comprueba lo que MAGI necesita en este sistema sin modificar nada' \
'autocompletado:Escribe el script de autocompletado de la shell en la salida estándar' \
'man:Escribe la página man de MAGI en la salida estándar' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'magi commands' commands "$@"
}
