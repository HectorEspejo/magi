#!/bin/sh
# nginx falso para la comprobación conocida (F13). El helper compartido
# sustituye @DIR@ por el directorio de estado de la prueba.
ESTADO="@DIR@"
echo "nginx $*" >> "$ESTADO/llamadas"
cat "$ESTADO/nginx_salida" >&2 2>/dev/null
codigo=$(cat "$ESTADO/nginx_codigo" 2>/dev/null) || codigo=0
exit "$codigo"
